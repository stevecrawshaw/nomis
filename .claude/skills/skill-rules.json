{
  "version": "1.0",
  "nomis-extract": {
    "type": "domain",
    "enforcement": "suggest",
    "priority": "medium",
    "promptTriggers": {
      "keywords": [
        "nomis",
        "nomisweb",
        "claimant count",
        "annual population survey",
        "census table",
        "population estimates",
        "lsoa data",
        "ward data",
        "msoa",
        "itl2",
        "itl3",
        "labour market data",
        "ons data",
        "travel to work",
        "economic activity",
        "jobs density",
        "gross weekly pay",
        "weca total",
        "west of england data",
        "lep total"
      ],
      "intentPatterns": [
        "(download|extract|get|pull|fetch|query)\\s+.*(nomis|ons|census|claimant|population estimate|labour market|annual population survey)",
        "(nomis|census|claimant count|population|earnings|employment)\\s+.*(by|for|per)\\s+.*(lsoa|msoa|ward|itl|local authorit|unitary|weca|west of england)",
        "(weca|west of england|lep)\\s+.*(total|figure|statistic|breakdown|data)\\s+.*(nomis|census|population|claimant|labour|employment|earnings)"
      ]
    },
    "description": "Identify the right NOMIS dataset and download only the required subset via the nomis MCP, with clarifying questions on topic, geography, timescale, columns and filters. Carries the West of England / WECA geography codes and the MAKE aggregate syntax."
  }
}
